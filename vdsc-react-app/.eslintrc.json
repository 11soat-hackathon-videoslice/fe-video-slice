{
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "react/prop-types": "warn",
    "react/jsx-uses-react": "warn",
    "react/react-in-jsx-scope": "off",
    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": [
      "warn",
      "always"
    ]
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
